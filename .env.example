# Moonraker base URL (no trailing slash). Optional: leave unset (or blank) to manage
# printers in the Settings UI instead. PRINTER_URL and MOONRAKER_API_KEY must be
# set together (environment printer) or both omitted.
# PRINTER_URL=http://printer.local:7125
# MOONRAKER_API_KEY=change-me
# MOONRAKER_ROOT=gcodes
# PORT=8088
# DATA_DIR=/data
# ORCA_BIN=/opt/orca/bin/orca-slicer
# ORCA_DATADIR=/data/orca-datadir
# MAX_UPLOAD_MB=150
# KEEP_JOBS=25
# SLICE_TIMEOUT=900
# Seconds one support-fins run may take (opt-in "support fins" upload). Finning is
# serialised: concurrent uploads queue behind the one running node process.
# SUPPORT_FINS_TIMEOUT=300
# BED_SIZE=220x220
# MACHINE_SLOT=system/Custom/machine/<your-machine>.json

# --- embedded printer UI (fallback, optional) ---
# The embedded printer UI is set per printer: Settings -> printer -> "Web UI URL". That is the
# address the Printer tab frames, and it follows whichever printer is active. This variable is
# only the fallback — it seeds the environment printer and covers a printer whose Web UI URL is
# empty. Either way the page is opened by your browser, so it must be reachable from your network
# (not from the container); an http URL inside an https portal is blocked as mixed content.
# Leave unset for no embedded UI.
# PRINTER_UI_URL=http://printer.local/

# --- UI-managed printers (optional) ---
# MOONRAKER_API_KEY is now optional when printers are managed in the Settings UI.
# PRINTER_URL and MOONRAKER_API_KEY must be set together (environment printer)
# or both omitted (manage printers in Settings).
# SLICED_DIR=/data/sliced
# PRINTERS_FILE=/data/printers.json
# SECRET_KEY_FILE=/data/secret.key
# ENV_PRINTER_NAME=Default (environment)